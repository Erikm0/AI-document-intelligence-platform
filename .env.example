# =====================================================================================
# DocIntel configuration. Copy to `.env` (repo root for Docker Compose, or backend/
# for local development) and adjust. Every variable is optional - defaults shown.
# Variable names are case-insensitive and map 1:1 to backend/app/core/config.py.
# Keep comments on their own lines: Docker Compose reads `KEY=  # note` as the
# value "# note" when KEY is empty.
# =====================================================================================

# --- Docker Compose ------------------------------------------------------------------
POSTGRES_USER=docintel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docintel
FRONTEND_PORT=3000
BACKEND_PORT=8000
OLLAMA_PORT=11434
# Bake the embedding / reranker weights into the backend image (offline start-up)
PRELOAD_MODELS=true
# Ollama as seen from the backend *container*. Use http://host.docker.internal:11434
# to reuse an Ollama already running on the host instead of the bundled service.
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Application ---------------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# structured JSON logs (true in docker-compose)
LOG_JSON=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Storage (local development; docker-compose overrides these) ---------------------
DATABASE_URL=postgresql+psycopg://docintel:change-me@localhost:5432/docintel
# DATABASE_URL=sqlite:///./data/docintel.db   # zero-setup alternative for development
# docker uses Alembic migrations instead
AUTO_CREATE_SCHEMA=true
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=25

# --- Chunking ------------------------------------------------------------------------
CHUNK_SIZE_TOKENS=128
CHUNK_OVERLAP_TOKENS=24
MIN_CHUNK_TOKENS=20

# --- Embeddings ----------------------------------------------------------------------
# sentence-transformers | hashing (tests/CI)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
# cpu | cuda | mps | empty = auto
EMBEDDING_DEVICE=
WARMUP_MODELS=true

# --- Vector store --------------------------------------------------------------------
# chroma-http | chroma-persistent | memory
VECTOR_STORE=chroma-http
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=document_chunks

# --- Retrieval -----------------------------------------------------------------------
# chunks given to the LLM
RETRIEVAL_TOP_K=6
# per retriever (dense and BM25) before fusion
RETRIEVAL_CANDIDATES=30
# fused candidates scored by the cross-encoder
RERANK_CANDIDATES=20
HYBRID_SEMANTIC_WEIGHT=1.0
HYBRID_LEXICAL_WEIGHT=1.0
RRF_K=60

# --- Reranking & guardrails ----------------------------------------------------------
# cross-encoder | lexical
RERANKER_PROVIDER=cross-encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Evidence gate. Empty = calibrated defaults (cross-encoder 0.1, bge-small cosine 0.5).
MIN_RELEVANCE_SCORE=
MIN_SEMANTIC_SCORE=
GROUNDING_HIGH_THRESHOLD=0.6
GROUNDING_MEDIUM_THRESHOLD=0.35
# refuse answers whose grounding is below "medium"
STRICT_GROUNDING=false

# --- LLM (Ollama) --------------------------------------------------------------------
# ollama | fake (extractive, no model needed)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# better quality: qwen2.5:7b, llama3.1:8b
OLLAMA_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=8192
# false = skip hidden reasoning of "thinking" models (faster)
OLLAMA_THINK=
LLM_TIMEOUT_SECONDS=180
MAX_CONTEXT_CHARS=12000
HISTORY_TURNS=4
QUERY_REWRITE_ENABLED=true
